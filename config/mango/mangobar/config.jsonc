// mangobar config (JSONC): minimal / compact. Colours live in style.css.
{
    "layer": "top",
    "height": 20,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        "hideclients",
        "tray",
        "network",
        // "keymode",
        // "keyboardlayout",
        // "cpu",
        // "memory",
        "pulseaudio",
        "backlight",
        "battery",
        "clock#date",
        "clock#time",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        // "pinned": [1, 2],
        // "tag-names": ["1", "2", "3", "编", "网"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "max-length": 480,  // pixels; keeps long titles from crowding the bar
        "on-click": "bash ~/.config/mango/scripts/screenshot.sh",
        "on-click-right": "bash ~/.config/mango/scripts/ocr.sh"
    },

    "network": {
        "format": "󰈀 {ifname}",
        "format-alt": "↓{down} ↑{up}"
        // Newer than mangobar 0.2.2, an icon that follows the link type:
        // "format": "{icon}", "format-wifi": "{signal}",
        // "format-disconnected": "{icon}",
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {}%"
    },
        "backlight": {
        "format": "{icon} {percent}%",
        "icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl -n1 set 5%-",
        "on-click": "brightnessctl set 1%"
    },
    "pulseaudio": {
        // {bt} is empty unless a Bluetooth sink is active
        "format": "{bt}{icon} {volume}%",
        "format-muted": "{bt}󰝟 {volume}%",
        "icon-bluetooth": "󰂯 ",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "icon-charging": "󰂄"
    },
    "clock#date": {
        "format": "{:L%a %d %b}"
    },
    "clock#time": {
        "format": "{:L%H:%M}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "custom/power": {
        "format": "󰣇",
        "on-click": "wlogout -C ~/.config/mango/wlogout/style.css -l ~/.config/mango/wlogout/layout -b 6 --protocol layer-shell",
        "on-click-right": "sleep 0.1s && swaync-client -t -sw"
    }
}
