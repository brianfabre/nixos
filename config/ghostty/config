# font-family = "GohuFont uni14 Nerd Font Propo"
# font-family = "DejaVuSansM Nerd Font Propo"
# font-family = "FantasqueSansM Nerd Font Propo"
font-family = "Menlo"
font-size = 20
# theme = "Monokai Pro Machine"
theme = "Ayu Mirage"

# mouse & clipboard
mouse-hide-while-typing = true
copy-on-select = clipboard

# look
macos-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
unfocused-split-opacity = 0.8

# new splits in current dir
tab-inherit-working-directory = true
split-inherit-working-directory = true

# scratchpad
keybind = global:alt+m=toggle_quick_terminal
quick-terminal-screen = mouse
